# ======================================================================
# CHOUTUPPAL SUPERAPP & UNIFIED CRM — ENVIRONMENT CONFIGURATION
# ======================================================================

# Public Website & Deployment URLs
NEXT_PUBLIC_APP_URL=https://choutuppal.in
PORT=3000

# WhatsApp Official Numbers (Master Blueprint)
NEXT_PUBLIC_WHATSAPP_STATUS_NUMBER=9441348175
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=9494348175

# ----------------------------------------------------------------------
# 1. Supabase Database & Auth (Backend Authentication)
# ----------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----------------------------------------------------------------------
# 2. Cloudflare R2 Object Storage (High-Speed Zero-Egress Media)
# ----------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=choutuppal-media
R2_PUBLIC_DOMAIN=https://media.choutuppal.in

# ----------------------------------------------------------------------
# 3. Meta WhatsApp Cloud API (Automated 24/7 Flow & Photo Cards)
# ----------------------------------------------------------------------
WHATSAPP_TOKEN=your-meta-whatsapp-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_VERIFY_TOKEN=choutuppal_verify_token
